# PromptOn server environment variables (plan.md §11.6). For local development, copy this file to
# .env and fill it in.
# Supervision tree mode: server (default) | library — start only the data layer (Repo, Vault,
# PubSub), for embedding the domain in another OTP app or running scripts. library does not need
# SECRET_KEY_BASE/PHX_HOST.
PTN_MODE=server
PTN_DATABASE_URL=ecto://postgres:password@localhost/prompton_dev
PTN_SECRET_KEY_BASE=
PTN_TOKEN_SIGNING_SECRET=
# base64-encoded 32 bytes: `openssl rand -base64 32`
PTN_VAULT_KEY=
PTN_PHX_HOST=localhost
# Phase 2 (Playground/Experiment) — temporary fallback until a ProviderKey is registered in the UI
PTN_OPENROUTER_API_KEY=
# Sign-in code email (Resend). Required in prod; in dev, without it mail piles up in /dev/mailbox.
PTN_RESEND_API_KEY=
# Sender (default "PromptOn <noreply@prompton.ai>")
PTN_MAIL_FROM=
# Docs site (prompton-docs). When set, /docs/agent redirects there with a 302. Leave empty locally.
PTN_DOCS_URL=
