<.auth_page id="invitation-unavailable-card" flash={@flash}>
  <h2 class="auth-h2">Invitation unavailable</h2>
  <p id="invitation-error" class="auth-error-banner" role="alert">
    {@error || "This invitation is invalid, expired, or has already been used."}
  </p>
  <a
    id="invitation-home"
    class="auth-submit"
    href={~p"/"}
    style="display:block;text-align:center;text-decoration:none;"
  >
    Go to PromptOn
  </a>
</.auth_page>
